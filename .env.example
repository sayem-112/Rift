# Copy to .env and adjust. Docker Compose and the Go server both read these.

# Postgres
POSTGRES_USER=rift
POSTGRES_PASSWORD=rift
POSTGRES_DB=rift
DATABASE_URL=postgres://rift:rift@localhost:5433/rift?sslmode=disable
# Integration tests create and drop throwaway databases on this server.
TEST_DATABASE_URL=postgres://rift:rift@localhost:5433/postgres?sslmode=disable

# Object storage (versitygw locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:7070
S3_REGION=us-east-1
S3_BUCKET=rift-books
# Create the bucket on startup (local development only).
S3_CREATE_BUCKET=true
S3_ACCESS_KEY=rift
S3_SECRET_KEY=rift-dev-secret
# Integration tests create and delete throwaway buckets here.
TEST_S3_ENDPOINT=http://localhost:7070

# API
RIFT_ADDR=:8080
# Metrics (/metrics) and profiling (/debug/pprof). Keep it private.
RIFT_INTERNAL_ADDR=127.0.0.1:6060
# The web app origin; sign-in links and Google redirects land here.
RIFT_WEB_URL=http://localhost:5173
# Signs access tokens. Generate your own: openssl rand -base64 32
RIFT_TOKEN_SECRET=
# Wraps every user's encryption key. Losing it makes all stored books unreadable:
# keep it in a secrets manager in production. Generate: openssl rand -base64 32
RIFT_MASTER_KEY=
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
RIFT_TRUST_PROXY=false

# Google sign-in (optional; disabled when empty).
# Authorized redirect URI: <RIFT_WEB_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional; without a key, sign-in links are printed in the server log).
RESEND_API_KEY=
RIFT_MAIL_FROM="rift <signin@example.com>"
